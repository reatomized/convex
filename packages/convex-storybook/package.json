{
  "name": "@reatomized/convex-storybook",
  "version": "0.0.0",
  "description": "A Storybook addon that answers @reatomized/convex functions with story handlers",
  "keywords": [
    "storybook-addon",
    "convex",
    "reatom",
    "testing"
  ],
  "homepage": "https://github.com/reatomized/convex/tree/reatom/packages/convex-storybook#readme",
  "bugs": {
    "url": "https://github.com/reatomized/convex/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/reatomized/convex.git",
    "directory": "packages/convex-storybook"
  },
  "license": "Apache-2.0",
  "author": "Aleksei Gurianov <gurianov@gmail.com>",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./preview": {
      "types": "./dist/preview.d.ts",
      "default": "./dist/preview.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node -e \"fs.rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json",
    "prepack": "npm run build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "peerDependencies": {
    "@reatom/core": "^1001.3.0",
    "@reatomized/convex": "^0.3.1",
    "convex": "^1.49.0",
    "storybook": "^9.0.0 || ^10.0.0 || ^11.0.0-0"
  },
  "devDependencies": {
    "@reatomized/convex": "file:../..",
    "storybook": "^10.6.5"
  },
  "publishConfig": {
    "access": "public"
  }
}
