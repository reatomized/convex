{
  "compilerOptions": {
    "target": "es2022",
    "module": "es2020",
    "moduleResolution": "bundler",
    "lib": ["es2022", "dom", "dom.iterable"],
    "rootDir": "./src",
    "outDir": "./dist",
    "declaration": true,
    "isolatedModules": true,
    "strict": true,
    "exactOptionalPropertyTypes": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": []
  },
  "files": ["src/index.ts", "src/preview.ts"]
}
