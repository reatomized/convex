{
  "name": "@reatomized/convex",
  "version": "0.4.0",
  "description": "A Convex sync client with its state in Reatom atoms",
  "keywords": [
    "convex",
    "reatom",
    "realtime",
    "state"
  ],
  "homepage": "https://github.com/reatomized/convex/tree/reatom#readme",
  "bugs": {
    "url": "https://github.com/reatomized/convex/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/reatomized/convex.git"
  },
  "license": "Apache-2.0",
  "author": "Aleksei Gurianov <gurianov@gmail.com>",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/browser/reatom/index.d.ts",
      "default": "./dist/browser/reatom/index.js"
    },
    "./convex-auth": {
      "types": "./dist/browser/reatom/convex_auth.d.ts",
      "default": "./dist/browser/reatom/convex_auth.js"
    },
    "./better-auth": {
      "types": "./dist/browser/reatom/better_auth.d.ts",
      "default": "./dist/browser/reatom/better_auth.js"
    },
    "./testing": {
      "types": "./dist/browser/reatom/testing.d.ts",
      "default": "./dist/browser/reatom/testing.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "workspaces": [
    ".",
    "packages/*"
  ],
  "scripts": {
    "build": "node scripts/build.mjs && npm run build --workspace @reatomized/convex-storybook",
    "prepack": "node scripts/build.mjs",
    "changeset": "changeset",
    "version-packages": "changeset version && npm install --package-lock-only --ignore-scripts --allow-remote=root",
    "release": "changeset publish",
    "typecheck": "tsc --noEmit && npm run typecheck --workspace @reatomized/convex-storybook",
    "test": "vitest run",
    "lint": "eslint ."
  },
  "peerDependencies": {
    "@reatom/core": "^1001.3.0",
    "convex": "^1.49.0"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@eslint/js": "^10.0.1",
    "@reatom/core": "https://pkg.pr.new/@reatom/core@5f42184",
    "@types/node": "^24.0.0",
    "convex": "1.49.0",
    "eslint": "^10.14.0",
    "globals": "^17.14.0",
    "happy-dom": "^21.0.4",
    "typescript": "~5.0.3",
    "typescript-eslint": "^8.72.0",
    "vitest": "^5.1.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
